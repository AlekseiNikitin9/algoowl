# Database
DATABASE_URL=postgresql+asyncpg://algoowl:algoowl_secret@postgres:5432/algoowl

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth — Google Sign-In
# Get the Web Client ID from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=

# OAuth — Apple Sign In
# Your app's bundle ID, e.g. com.yourcompany.codekata
APPLE_CLIENT_ID=

# AI (Phase D)
OPENAI_API_KEY=sk-placeholder

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
